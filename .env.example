# Copy this file to .env. Never commit the resulting .env file.
ENVIRONMENT=development
APP_NAME=K8ight AI Chat Bot Assistant
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_TIMEOUT_SECONDS=60

# Use your deployed HTTPS domain in production. Separate multiple origins with commas.
ALLOWED_ORIGINS=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional tuning
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_LIMIT=4
MAX_CONTEXT_CHARACTERS=7000
